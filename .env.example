# Remote ComfyUI instance URL (HTTP/HTTPS, without trailing slash)
COMFYUI_URL=http://192.168.1.100:8188

# Backend data directory inside container (SQLite + downloaded media outputs)
DATA_DIR=/app/data

# Optional: AI Studio / preview runtime variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
